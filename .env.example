# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

#Redis
REDIS_URL=

#BullMQ
BULLMQ_QUEUE_NAME=
BACKEND_PORT=
FRONTEND_PORT=
WORKER_REPLICAS=5
WORKER_CONCURRENCY=2

#issuemining
OPENAI_API_KEY=
GITHUB_API_TOKEN=                       #token1, token2, token3 ... (comma-separated list of tokens for load balancing)
GITHUB_MINER_TIMEOUT_MS=20000
ISSUES_MINING_TIMEOUT_MS=300000
ISSUES_MINING_LOOKBACK_DAYS=60
ISSUES_MINING_MAX_ISSUES=10
ISSUES_MINING_RECENT_OPEN_LIMIT=30
ISSUES_MINING_RECENT_CLOSED_LIMIT=40
ISSUES_MINING_OLDER_CLOSED_LIMIT=30
ISSUES_MINING_OLD_OPEN_LIMIT=20
ISSUES_MINING_HISTORY_START_DATE=2015-01-01
ISSUES_MINING_TIMELINE_ITEMS=15
ISSUES_MINING_MAX_TIMELINE_PAGES=1
ISSUES_MINING_TOKEN_STATUS_TTL_MS=60000
ISSUES_MINING_INCLUDE_DEV_DEPENDENCIES=false
DEPENDENCY_CACHE_VERSION=v1
DEPENDENCY_CACHE_TTL_DAYS=14
PARTIAL_DEPENDENCY_CACHE_TTL_DAYS=1
DEPENDENCY_CACHE_LOCK_WAIT_MS=300000

#mailer
MAILER_USER=
GMAIL_APP_PASSWORD=
# Optional: only if you need a non-Gmail SMTP host
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
APP_PUBLIC_URL=http://localhost:5173

#dependency sync
DEPENDENCY_SYNC_ENABLED=true
DEPENDENCY_SYNC_INTERVAL_MS=604800000   #7 days in milliseconds
DEPENDENCY_SYNC_RUN_ON_START=false
DEPENDENCY_SYNC_TOP_LIMIT=10            #number of dependencies to sync per run

#dependency relationships
DEPENDENCY_RELATIONSHIPS_ENABLED=true
DEPENDENCY_RELATIONSHIP_EVIDENCE_LIMIT=3
DEPENDENCY_RELATIONSHIP_SEARCH_RESULTS=3      #deprecated alias for DEPENDENCY_RELATIONSHIP_EVIDENCE_LIMIT
DEPENDENCY_RELATIONSHIP_DEEP_ISSUES_ENABLED=auto
DEPENDENCY_RELATIONSHIP_DEEP_MIN_SCORE_SAMPLE_ISSUES=30
DEPENDENCY_RELATIONSHIP_ISSUES_MAX_ISSUES=80
DEPENDENCY_RELATIONSHIP_ISSUES_LOOKBACK_DAYS=60
DEPENDENCY_RELATIONSHIP_ISSUES_TIMEOUT_MS=300000
DEPENDENCY_RELATIONSHIP_CACHE_TTL_DAYS=14


#explore
EXPLORE_TOP_LIMIT=12
EXPLORE_REFRESH_INTERVAL_MS=604800000       #7 days in milliseconds
EXPLORE_RUN_ON_START=false

#dependency sync
DEPENDENCY_SYNC_ENABLED=true
DEPENDENCY_SYNC_INTERVAL_MS=604800000       #7 days in milliseconds
DEPENDENCY_SYNC_RUN_ON_START=false
DEPENDENCY_SYNC_TOP_LIMIT=10                #number of dependencies to sync per run
